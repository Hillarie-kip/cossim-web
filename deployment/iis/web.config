<?xml version="1.0" encoding="utf-8"?>
<!-- Copy beside the existing server.js in the IIS application root. -->
<configuration>
  <system.webServer>
    <iisnode node_env="production"
             nodeProcessCountPerApplication="1"
             maxConcurrentRequestsPerProcess="1024"
             maxNamedPipeConnectionRetry="100"
             namedPipeConnectionRetryDelay="250"
             gracefulShutdownTimeout="60000"
             loggingEnabled="true"
             logDirectory="iisnode"
             debuggingEnabled="false"
             devErrorsEnabled="false"
             watchedFiles="web.config;server.js;iisnode.yml"
             nodeProcessCommandLine="&quot;C:\Program Files\nodejs\node.exe&quot;" />
    <handlers>
      <remove name="iisnode" />
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="NextJsApplication" stopProcessing="true">
          <match url=".*" />
          <!-- Next.js handles pages, public files, and /_next/static assets. -->
          <action type="Rewrite" url="server.js" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
    <!-- Preserve Next.js response status/body for diagnosis. -->
    <httpErrors existingResponse="PassThrough" />
    <!-- Use inherited MIME mappings; duplicate mappings can cause 500.19. -->
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
